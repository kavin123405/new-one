{
  "name": "surprise-website-root",
  "version": "1.0.0",
  "description": "Romantic surprise website full stack setup",
  "main": "server.js",
  "scripts": {
    "install-all": "npm.cmd install && cd client && npm.cmd install",
    "server": "node server.js",
    "client": "cd client && npm.cmd run dev",
    "dev": "concurrently \"npm.cmd run server\" \"npm.cmd run client\"",
    "build": "cd client && npm.cmd run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
